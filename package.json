{
  "name": "cheghad",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "deploy:accounts": "node scripts/deploy-accounts.mjs",
    "test:accounts-runtime": "wrangler deploy --dry-run --config accounts/wrangler.toml --outdir .wrangler/runtime-check && node accounts/runtime-check.mjs",
    "test:e2e:accounts": "playwright test --config playwright.account.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "decimal.js": "^10.6.0",
    "idb": "^8.0.0",
    "jalaali-js": "^1.2.8",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.0",
    "miniflare": "^5.20261023.1-beta",
    "prettier": "^3.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "node": ">=24"
  }
}
